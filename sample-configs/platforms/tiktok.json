{
  "id": "tiktok",
  "label": "TikTok",
  "version": 5,
  "hostMatch": "tiktok.com",
  "profileUrlPattern": "tiktok.com/@",
  "type": "json_script",
  "scriptId": ["SIGI_STATE", "__UNIVERSAL_DATA_FOR_REHYDRATION__"],
  "usePathResolver": "tiktok",
  "fields": {
    "username": "UserModule.users.0.uniqueId",
    "displayName": "UserModule.users.0.nickname",
    "bio": "UserModule.users.0.signature",
    "followers": "UserModule.users.0.stats.followerCount",
    "following": "UserModule.users.0.stats.followingCount",
    "videoCount": "UserModule.users.0.stats.videoCount",
    "heartCount": "UserModule.users.0.stats.heartCount",
    "verified": "UserModule.users.0.verified"
  }
}
